    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5070"
      }
    }
  },
  "Scheduler": {
    "DiscoveryIntervalMinutes": 30,
    "EnableAutoSyncConfluence": true,
    "ConfluenceSyncTime": "04:00",
    "ConfluenceSyncIntervalHours": 24
  },
  "Confluence": {
    "BaseUrl": "https://space.example.com",
    "BearerToken": "YOUR_CONFLUENCE_API_TOKEN_HERE",
    "PageIdDev": "44154018",
    "PageIdProd": "44154087",
    "PageIdSaInfo": "54793711",
    "SpaceKey": "itinfra",
    "SpaceKeySaInfo": "FAQ",
    "AncestorIdDevProd": "89329326",
    "AncestorIdSaInfo": "20382191"
  },
  "Email": {
    "SmtpServer": "mail.example.com",
    "SmtpPort": 587,
    "Sender": "postmaster@example.com",
    "Username": "postmaster@example.corp",
    "Password": "YourEmailPassword123!",
    "Recipient": "admin@example.com",
    "EnableAlerts": true
  },
  "Ui": {
    "ShowMetrics": true
  },
  "Rac": {
    "RacPath": "C:\\Program Files\\1cv8\\8.3.25.1445\\bin\\rac.exe",
    "TimeoutSeconds": 15,
    "MaxConcurrency": 16
  },
  "Consul": {
    "Url": "http://consul.example.corp:8500",
    "TimeoutSeconds": 5
  },
  "ActiveDirectory": {
    "Domain": "example.corp",
    "LdapServer": "",
    "Username": "svc_1c_inventory",
    "Password": "YourSecureAdPassword123!",
    "GroupFilters": [ "rdp_1c_*", "1cbases_*" ],
    "ManageableGroupPatterns": [ "rdp_1c_*", "1cbases*" ],
    "V8iBasePath": "\\\\fileserver.example.corp\\1c_bases"
  },
  "Dbms": {
    "DefaultSqlUsername": "monitoring_user",
    "DefaultSqlPassword": "YourSecureDbmsPassword123!",
    "DefaultPgUsername": "monitoring_user",
    "DefaultPgPassword": "YourSecureDbmsPassword123!",
    "ConnectionTimeoutSeconds": 8,
    "TrustServerCertificate": true
  },
  "ClusterDiscovery": {
    "Enabled": true,
    "DefaultClusterUser": "admin_1c",
    "DefaultClusterPassword": "YourClusterPassword123!",
    "WmiQueryTimeoutSeconds": 30,
    "Servers": [
      { "Host": "app-dev01.example.corp", "Environment": "DEV" },
      { "Host": "app-dev02.example.corp", "Environment": "DEV" },
      { "Host": "app-prod01.example.corp", "Environment": "PROD" },
      { "Host": "app-prod02.example.corp", "Environment": "PROD" },
      { "Host": "app-prod03.example.corp", "Environment": "PROD" }
    ]
  },
  "AuditLog": {
    "RetentionDays": 30,
    "MaxLogSizeBytes": 524288000,
    "LogFilePath": "logs/audit.jsonl"
  },
  "SqlRestore": {
    "BackupArchiveRoot": "\\\\backup_sql\\sql_archive$",
    "AllowedTargetServers": [ "dev-s-sql01.example.corp", "dev-s-sql02.example.corp" ],
    "AllowedDomainSuffixes": [ "example.corp" ],
    "DefaultRestoreUsername": "sql_restore",
    "DefaultRestorePassword": "YourDevSqlRestorePassword123!",
    "ExcludedCatalogs": [
      "SQL_LEGACY_ARCHIVE",
      "DWH_ANALYTICS_SRV01",
      "CRM_BACKUP_STORE",
      "FIN_DATA_VAULT"
    ],
    "ExcludedDatabases": [ "master", "model", "msdb", "tempdb", "distribution", "SUSDB", "DBADB", "DBASQLPerformance", "ReportServer", "ReportServerTempDB" ],
    "CommandTimeoutMinutes": 180,
    "CacheDurationMinutes": 15,
    "InfobaseAdminCredentials": [
      {
        "Username": "infobase_admin",
        "Password": "YourInfobaseAdminPassword123!"
      }
    ]
  },
  "IisPublications": {
    "Enabled": true,
    "ExtraHosts": [],
